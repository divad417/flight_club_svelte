{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "types": ["$app/types", "jest"],
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false
  },
  "include": ["src", "*.js", "*.mjs", "*.ts"],
  "exclude": ["node_modules", "build", ".svelte-kit", "functions"]
}
